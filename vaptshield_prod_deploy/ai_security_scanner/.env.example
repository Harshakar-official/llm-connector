# AI Security Scanner — Environment Variables
# Copy to .env and fill in values

# Supabase Database
PGHOST=aws-1-ap-south-1.pooler.supabase.com
PGPORT=6543
PGDATABASE=postgres
PGUSER=postgres.yourproject
PGPASSWORD=yourpassword

# LLM Gateway (LiteLLM)
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.3-70b-versatile

# Scanner Config
SCANNER_PORT=8090
SCANNER_HOST=0.0.0.0
MAX_CONCURRENT_PROBES=5
PROBE_TIMEOUT_SECONDS=30

# VAPTShield Integration
DOCKER_HOST_API_KEY=your-worker-api-key
JWT_SECRET=your-jwt-secret
